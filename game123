<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Neon Velocity | Arcade Racer</title>
    <!-- Tailwind CSS for crisp UI overlays -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Orbitron & Inter for futuristic arcade aesthetics -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=Orbitron:wght@500;700;900&display=swap" rel="stylesheet">
    <style>
        /* Custom Arcade Styling & Animations */
        :root {
            --neon-cyan: #00f3ff;
            --neon-pink: #ff007f;
            --neon-yellow: #ffe600;
            --dark-bg: #090a10;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            touch-action: manipulation;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            background-color: var(--dark-bg);
            font-family: 'Inter', sans-serif;
            overflow: hidden;
            color: white;
        }

        .font-arcade {
            font-family: 'Orbitron', sans-serif;
        }

        /* Game Wrapper & Responsive Canvas */
        #game-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle at center, #16192b 0%, #07080d 100%);
        }

        canvas {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* Arcade Glassmorphism Panels */
        .hud-panel {
            background: rgba(12, 16, 29, 0.72);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(0, 243, 255, 0.3);
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.15);
        }

        .neon-text-cyan {
            text-shadow: 0 0 8px rgba(0, 243, 255, 0.8), 0 0 16px rgba(0, 243, 255, 0.4);
        }

        .neon-text-pink {
            text-shadow: 0 0 8px rgba(255, 0, 127, 0.8), 0 0 16px rgba(255, 0, 127, 0.4);
        }

        /* Arcade Styled Buttons */
        .arcade-btn {
            background: linear-gradient(135deg, #ff007f 0%, #7928ca 100%);
            border: 2px solid rgba(255, 255, 255, 0.35);
            box-shadow: 0 6px 20px rgba(255, 0, 127, 0.45), inset 0 2px 4px rgba(255, 255, 255, 0.4);
            transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
            cursor: pointer;
        }

        .arcade-btn:hover {
            transform: translateY(-2px) scale(1.02);
            box-shadow: 0 10px 25px rgba(255, 0, 127, 0.65), inset 0 2px 6px rgba(255, 255, 255, 0.6);
            filter: brightness(1.1);
        }

        .arcade-btn:active {
            transform: translateY(2px) scale(0.98);
        }

        .arcade-btn-secondary {
            background: linear-gradient(135deg, #00c6ff 0%, #0072ff 100%);
            border: 2px solid rgba(255, 255, 255, 0.35);
            box-shadow: 0 4px 15px rgba(0, 198, 255, 0.4), inset 0 2px 4px rgba(255, 255, 255, 0.4);
        }

        /* Touch Control Pads */
        .touch-pad {
            background: rgba(255, 255, 255, 0.08);
            border: 2px solid rgba(0, 243, 255, 0.35);
            backdrop-filter: blur(4px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
            transition: background 0.1s, transform 0.1s;
        }

        .touch-pad:active, .touch-pad.active {
            background: rgba(0, 243, 255, 0.35);
            border-color: #00f3ff;
            transform: scale(0.94);
        }

        .touch-pad-nitro {
            border-color: rgba(255, 0, 127, 0.5);
        }
        .touch-pad-nitro:active, .touch-pad-nitro.active {
            background: rgba(255, 0, 127, 0.45);
            border-color: #ff007f;
        }

        /* Pulse animation for Low Time Warning */
        @keyframes pulseWarning {
            0%, 100% { transform: scale(1); color: #ff2a5f; }
            50% { transform: scale(1.12); color: #ffffff; }
        }
        .timer-warning {
            animation: pulseWarning 0.6s infinite;
        }

        /* Scanline Overlay for subtle retro feel */
        .scanlines {
            pointer-events: none;
            position: absolute;
            inset: 0;
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.18) 50%
            );
            background-size: 100% 4px;
            z-index: 5;
        }
    </style>
</head>
<body>

<div id="game-wrapper">
    <!-- Main Rendering Canvas -->
    <canvas id="gameCanvas"></canvas>

    <!-- Subtle CRT Scanline Effect -->
    <div class="scanlines"></div>

    <!-- Top Heads-Up Display (HUD) -->
    <div id="hud-container" class="hidden absolute top-0 left-0 right-0 z-10 p-3 sm:p-5 flex flex-wrap justify-between items-start gap-2 pointer-events-none">
        <!-- Left HUD: Score & High Score -->
        <div class="hud-panel rounded-2xl px-4 py-2.5 flex items-center gap-4">
            <div>
                <div class="text-[10px] sm:text-xs uppercase tracking-widest text-cyan-300 font-semibold">Score</div>
                <div id="hud-score" class="font-arcade text-xl sm:text-2xl font-black text-white neon-text-cyan">000000</div>
            </div>
            <div class="h-8 w-[1px] bg-cyan-500/30"></div>
            <div>
                <div class="text-[10px] sm:text-xs uppercase tracking-widest text-pink-300 font-semibold">Best</div>
                <div id="hud-best" class="font-arcade text-sm sm:text-lg font-bold text-pink-400">000000</div>
            </div>
        </div>

        <!-- Center HUD: Checkpoint Timer -->
        <div class="hud-panel rounded-2xl px-5 py-2 text-center border-yellow-400/40">
            <div class="text-[10px] sm:text-xs uppercase tracking-widest text-yellow-300 font-semibold">Time Left</div>
            <div id="hud-time" class="font-arcade text-2xl sm:text-3xl font-black text-yellow-400">45.0</div>
            <div id="hud-stage" class="text-[10px] uppercase tracking-wider text-gray-300">Stage 1</div>
        </div>

        <!-- Right HUD: Speedometer, Nitro & Sound Toggle -->
        <div class="flex items-center gap-2 pointer-events-auto">
            <div class="hud-panel rounded-2xl px-4 py-2.5 flex flex-col items-end min-w-[125px] sm:min-w-[155px]">
                <div class="flex items-baseline gap-1">
                    <span id="hud-speed" class="font-arcade text-xl sm:text-2xl font-black text-white">0</span>
                    <span class="text-xs font-bold text-cyan-400">KM/H</span>
                </div>
                <!-- Nitro Bar -->
                <div class="w-full mt-1.5">
                    <div class="flex justify-between text-[9px] uppercase font-bold tracking-wider mb-0.5">
                        <span class="text-pink-400">Nitro</span>
                        <span id="hud-nitro-text" class="text-white">100%</span>
                    </div>
                    <div class="w-full h-2 bg-gray-800 rounded-full overflow-hidden border border-white/10">
                        <div id="hud-nitro-bar" class="h-full bg-gradient-to-r from-cyan-400 via-pink-500 to-yellow-400 transition-all duration-75" style="width: 100%;"></div>
                    </div>
                </div>
            </div>

            <!-- Mute / Pause Buttons -->
            <div class="flex flex-col gap-1.5">
                <button id="btn-sound" title="Toggle Audio" class="hud-panel hover:bg-cyan-500/20 p-2.5 rounded-xl text-cyan-300 transition">
                    <svg id="icon-sound-on" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
                    <svg id="icon-sound-off" class="w-5 h-5 hidden text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg>
                </button>
                <button id="btn-pause" title="Pause Game" class="hud-panel hover:bg-cyan-500/20 p-2.5 rounded-xl text-cyan-300 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Floating Notification Banner (Checkpoints / Near Misses) -->
    <div id="floating-banner" class="pointer-events-none absolute top-28 left-1/2 -translate-x-1/2 z-10 text-center opacity-0 transition-opacity duration-300">
        <div id="banner-title" class="font-arcade text-2xl sm:text-4xl font-black text-yellow-300 neon-text-cyan tracking-wider">CHECKPOINT!</div>
        <div id="banner-sub" class="font-arcade text-sm sm:text-lg font-bold text-white">+20 SECONDS</div>
    </div>

    <!-- Mobile / Touch Controls Overlay -->
    <div id="touch-controls" class="hidden md:hidden absolute bottom-4 left-0 right-0 z-10 px-4 flex justify-between items-end pointer-events-none">
        <!-- Steering Left / Right -->
        <div class="flex gap-3 pointer-events-auto">
            <button id="touch-left" class="touch-pad w-16 h-16 sm:w-20 sm:h-20 rounded-2xl flex items-center justify-center text-cyan-300">
                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
            </button>
            <button id="touch-right" class="touch-pad w-16 h-16 sm:w-20 sm:h-20 rounded-2xl flex items-center justify-center text-cyan-300">
                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
            </button>
        </div>

        <!-- Pedals: Brake, Nitro, Gas -->
        <div class="flex gap-2.5 items-end pointer-events-auto">
            <button id="touch-brake" class="touch-pad w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex flex-col items-center justify-center text-red-400 font-arcade text-xs font-bold">
                <span>BRK</span>
            </button>
            <button id="touch-nitro" class="touch-pad touch-pad-nitro w-16 h-16 sm:w-20 sm:h-20 rounded-2xl flex flex-col items-center justify-center text-pink-400 font-arcade text-xs font-bold">
                <svg class="w-6 h-6 mb-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path></svg>
                <span>NITRO</span>
            </button>
            <button id="touch-gas" class="touch-pad w-16 h-20 sm:w-20 sm:h-24 rounded-2xl flex flex-col items-center justify-center text-emerald-400 font-arcade text-xs font-bold">
                <svg class="w-7 h-7 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path></svg>
                <span>GAS</span>
            </button>
        </div>
    </div>

    <!-- START MENU OVERLAY -->
    <div id="menu-start" class="absolute inset-0 z-20 flex items-center justify-center p-4 bg-black/55 backdrop-blur-sm">
        <div class="hud-panel max-w-lg w-full rounded-3xl p-6 sm:p-8 text-center border-2 border-cyan-400/50 shadow-2xl">
            <div class="inline-block px-3 py-1 rounded-full bg-pink-500/20 border border-pink-500/50 text-pink-300 font-arcade text-xs tracking-widest uppercase mb-3">
                Synthwave Arcade Edition
            </div>
            <h1 class="font-arcade text-4xl sm:text-6xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-white to-pink-500 mb-2">
                NEON VELOCITY
            </h1>
            <p class="text-gray-300 text-sm sm:text-base mb-6">
                Outrun the clock, weave through highway traffic, and hit checkpoints at 300+ KM/H.
            </p>

            <!-- Car Color Selector -->
            <div class="mb-6">
                <div class="text-xs uppercase tracking-widest text-cyan-300 font-bold mb-2.5">Select Interceptor Paint</div>
                <div class="flex justify-center gap-3" id="car-color-picker">
                    <button data-color="#ff0055" data-accent="#00f3ff" class="color-swatch w-10 h-10 rounded-full border-2 border-white ring-2 ring-pink-500 scale-110 transition" style="background: linear-gradient(135deg, #ff0055, #990033);"></button>
                    <button data-color="#00d2ff" data-accent="#ffe600" class="color-swatch w-10 h-10 rounded-full border-2 border-white/40 transition" style="background: linear-gradient(135deg, #00d2ff, #005bb5);"></button>
                    <button data-color="#ffe600" data-accent="#ff0055" class="color-swatch w-10 h-10 rounded-full border-2 border-white/40 transition" style="background: linear-gradient(135deg, #ffe600, #ff8800);"></button>
                    <button data-color="#00ff88" data-accent="#00f3ff" class="color-swatch w-10 h-10 rounded-full border-2 border-white/40 transition" style="background: linear-gradient(135deg, #00ff88, #008844);"></button>
                    <button data-color="#b829ff" data-accent="#ffe600" class="color-swatch w-10 h-10 rounded-full border-2 border-white/40 transition" style="background: linear-gradient(135deg, #b829ff, #5500aa);"></button>
                </div>
            </div>

            <!-- Controls Guide Box -->
            <div class="bg-black/40 rounded-2xl p-4 mb-6 border border-white/10 text-left grid grid-cols-2 gap-3 text-xs sm:text-sm">
                <div class="flex items-center gap-2">
                    <span class="px-2 py-1 rounded bg-white/10 font-arcade text-cyan-300 font-bold">W / ↑</span>
                    <span class="text-gray-300">Accelerate</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-2 py-1 rounded bg-white/10 font-arcade text-cyan-300 font-bold">S / ↓</span>
                    <span class="text-gray-300">Brake</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-2 py-1 rounded bg-white/10 font-arcade text-cyan-300 font-bold">A D / ← →</span>
                    <span class="text-gray-300">Steer</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-2 py-1 rounded bg-pink-500/20 border border-pink-500/40 font-arcade text-pink-300 font-bold">SHIFT / SPACE</span>
                    <span class="text-gray-300">Nitro Boost</span>
                </div>
            </div>

            <button id="btn-start" class="arcade-btn w-full py-4 rounded-2xl font-arcade text-xl sm:text-2xl font-black tracking-wider text-white uppercase">
                Start Engine
            </button>
        </div>
    </div>

    <!-- PAUSE MENU OVERLAY -->
    <div id="menu-pause" class="hidden absolute inset-0 z-20 flex items-center justify-center p-4 bg-black/65 backdrop-blur-sm">
        <div class="hud-panel max-w-sm w-full rounded-3xl p-6 text-center border-2 border-cyan-400/50">
            <h2 class="font-arcade text-3xl font-black text-cyan-300 neon-text-cyan mb-2">PAUSED</h2>
            <p class="text-gray-300 text-sm mb-6">Engine idling. Ready to resume?</p>
            <div class="flex flex-col gap-3">
                <button id="btn-resume" class="arcade-btn w-full py-3.5 rounded-2xl font-arcade text-lg font-bold text-white uppercase">
                    Resume Race
                </button>
                <button id="btn-restart-pause" class="arcade-btn arcade-btn-secondary w-full py-3 rounded-2xl font-arcade text-base font-bold text-white uppercase">
                    Restart
                </button>
            </div>
        </div>
    </div>

    <!-- GAME OVER OVERLAY -->
    <div id="menu-gameover" class="hidden absolute inset-0 z-20 flex items-center justify-center p-4 bg-black/70 backdrop-blur-md">
        <div class="hud-panel max-w-md w-full rounded-3xl p-6 sm:p-8 text-center border-2 border-pink-500/60 shadow-2xl">
            <div id="gameover-reason" class="inline-block px-3 py-1 rounded-full bg-red-500/20 border border-red-500/50 text-red-300 font-arcade text-xs tracking-widest uppercase mb-2">
                Time Expired
            </div>
            <h2 class="font-arcade text-4xl sm:text-5xl font-black text-white neon-text-pink mb-6">
                RACE OVER
            </h2>

            <!-- Run Stats -->
            <div class="grid grid-cols-2 gap-3 mb-6">
                <div class="bg-black/40 rounded-2xl p-3 border border-white/10">
                    <div class="text-[11px] uppercase text-gray-400 font-semibold">Final Score</div>
                    <div id="final-score" class="font-arcade text-xl sm:text-2xl font-black text-cyan-300">0</div>
                </div>
                <div class="bg-black/40 rounded-2xl p-3 border border-white/10">
                    <div class="text-[11px] uppercase text-gray-400 font-semibold">High Score</div>
                    <div id="final-best" class="font-arcade text-xl sm:text-2xl font-black text-yellow-400">0</div>
                </div>
                <div class="bg-black/40 rounded-2xl p-3 border border-white/10">
                    <div class="text-[11px] uppercase text-gray-400 font-semibold">Distance</div>
                    <div id="final-distance" class="font-arcade text-lg font-bold text-white">0.0 km</div>
                </div>
                <div class="bg-black/40 rounded-2xl p-3 border border-white/10">
                    <div class="text-[11px] uppercase text-gray-400 font-semibold">Near Misses</div>
                    <div id="final-nearmiss" class="font-arcade text-lg font-bold text-pink-400">0</div>
                </div>
            </div>

            <button id="btn-play-again" class="arcade-btn w-full py-4 rounded-2xl font-arcade text-xl font-black tracking-wider text-white uppercase">
                Race Again
            </button>
        </div>
    </div>
</div>

<script>
/**
 * ============================================================================
 * NEON VELOCITY - 2.5D PSEUDO-3D ARCADE CAR RACING ENGINE
 * ============================================================================
 * Complete self-contained architecture featuring:
 * 1. Web Audio API Synthesizer (Procedural engine RPM, tire screech, nitro, crash)
 * 2. Pseudo-3D Road Projection Engine (Curves, Hills, Roadside Scenery, Checkpoints)
 * 3. Physics & Collision Detection (Centrifugal force, drift, traffic AI, near-misses)
 * 4. Particle System (Exhaust sparks, nitro flames, smoke, crash debris)
 * 5. Responsive Canvas & Multi-Input Handler (Keyboard + Touch)
 */

// ============================================================================
// 1. PROCEDURAL WEB AUDIO ENGINE (No external audio files required)
// ============================================================================
class SoundEngine {
    constructor() {
        this.ctx = null;
        this.enabled = true;
        this.engineOsc = null;
        this.engineGain = null;
        this.subOsc = null;
        this.initialized = false;
    }

    init() {
        if (this.initialized) return;
        try {
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            this.ctx = new AudioCtx();

            // Primary Engine Sawtooth Oscillator
            this.engineOsc = this.ctx.createOscillator();
            this.engineOsc.type = 'sawtooth';
            this.engineOsc.frequency.value = 55;

            // Sub-bass Engine Rumble
            this.subOsc = this.ctx.createOscillator();
            this.subOsc.type = 'triangle';
            this.subOsc.frequency.value = 27.5;

            // Lowpass filter to warm up the engine sound
            this.filter = this.ctx.createBiquadFilter();
            this.filter.type = 'lowpass';
            this.filter.frequency.value = 280;

            this.engineGain = this.ctx.createGain();
            this.engineGain.gain.value = 0.0;

            this.engineOsc.connect(this.filter);
            this.subOsc.connect(this.filter);
            this.filter.connect(this.engineGain);
            this.engineGain.connect(this.ctx.destination);

            this.engineOsc.start();
            this.subOsc.start();
            this.initialized = true;
        } catch (e) {
            console.warn('Web Audio API unavailable:', e);
        }
    }

    toggle() {
        this.enabled = !this.enabled;
        if (!this.enabled && this.engineGain) {
            this.engineGain.gain.setTargetAtTime(0, this.ctx.currentTime, 0.05);
        }
        return this.enabled;
    }

    updateEngine(speedRatio, isNitro, isPlaying) {
        if (!this.initialized || !this.enabled || !isPlaying) {
            if (this.engineGain && this.ctx) {
                this.engineGain.gain.setTargetAtTime(0, this.ctx.currentTime, 0.08);
            }
            return;
        }

        if (this.ctx.state === 'suspended') {
            this.ctx.resume();
        }

        // Simulate 5-gear shifting pitch curve
        const gearProgress = (speedRatio * 4.5) % 1;
        const baseFreq = 48 + (speedRatio * 95) + (gearProgress * 32) + (isNitro ? 35 : 0);
        
        this.engineOsc.frequency.setTargetAtTime(baseFreq, this.ctx.currentTime, 0.04);
        this.subOsc.frequency.setTargetAtTime(baseFreq * 0.5, this.ctx.currentTime, 0.04);
        this.filter.frequency.setTargetAtTime(220 + speedRatio * 550 + (isNitro ? 400 : 0), this.ctx.currentTime, 0.05);
        this.engineGain.gain.setTargetAtTime(0.08 + speedRatio * 0.07, this.ctx.currentTime, 0.05);
    }

    playCrash() {
        if (!this.initialized || !this.enabled) return;
        const now = this.ctx.currentTime;
        
        // White noise burst for impact
        const bufferSize = this.ctx.sampleRate * 0.45;
        const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
        const data = buffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (this.ctx.sampleRate * 0.12));
        }

        const noise = this.ctx.createBufferSource();
        noise.buffer = buffer;

        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(600, now);
        filter.frequency.exponentialRampToValueAtTime(80, now + 0.4);

        const gain = this.ctx.createGain();
        gain.gain.setValueAtTime(0.35, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.45);

        noise.connect(filter);
        filter.connect(gain);
        gain.connect(this.ctx.destination);
        noise.start(now);
    }

    playCheckpoint() {
        if (!this.initialized || !this.enabled) return;
        const now = this.ctx.currentTime;
        const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
        notes.forEach((freq, idx) => {
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, now + idx * 0.07);
            gain.gain.setValueAtTime(0.14, now + idx * 0.07);
            gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.07 + 0.25);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now + idx * 0.07);
            osc.stop(now + idx * 0.07 + 0.26);
        });
    }

    playNearMiss() {
        if (!this.initialized || !this.enabled) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(300, now);
        osc.frequency.exponentialRampToValueAtTime(900, now + 0.14);
        gain.gain.setValueAtTime(0.12, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.17);
    }
}

