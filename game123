// ============================================================================
// 6. PROJECTION & RENDERING PIPELINE
// ============================================================================
function project(p, cameraX, cameraY, cameraZ, cameraDepth, width, height, roadWidth) {
    p.camera.x = (p.world.x || 0) - cameraX;
    p.camera.y = (p.world.y || 0) - cameraY;
    p.camera.z = (p.world.z || 0) - cameraZ;

    const scale = cameraDepth / Math.max(1, p.camera.z);
    p.screen.scale = scale;
    p.screen.x = Math.round((width / 2) + (scale * p.camera.x * width / 2));
    p.screen.y = Math.round((height / 2) - (scale * p.camera.y * height / 2));
    p.screen.w = Math.round((scale * roadWidth * width / 2));
}

function drawPolygon(x1, y1, x2, y2, x3, y3, x4, y4, color) {
    ctx.fillStyle = color;
    ctx.beginPath();
    ctx.moveTo(x1, y1);
    ctx.lineTo(x2, y2);
    ctx.lineTo(x3, y3);
    ctx.lineTo(x4, y4);
    ctx.closePath();
    ctx.fill();
}

function drawBackground() {
    // 1. Synthwave Night Sky Gradient
    const skyGrad = ctx.createLinearGradient(0, 0, 0, height * 0.58);
    skyGrad.addColorStop(0, COLORS.SKY_TOP);
    skyGrad.addColorStop(0.55, COLORS.SKY_MID);
    skyGrad.addColorStop(1, COLORS.SKY_HORIZON);
    ctx.fillStyle = skyGrad;
    ctx.fillRect(0, 0, width, height);

    // 2. Twinkling Stars
    ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
    for (let i = 0; i < 45; i++) {
        const sx = ((i * 197 + state.skyOffset * 0.2) % width + width) % width;
        const sy = (i * 89) % (height * 0.38);
        const size = (i % 3 === 0) ? 2 : 1.2;
        ctx.fillRect(sx, sy, size, size);
    }

    // 3. Retro Outrun Sun with Horizontal Stripes
    const sunRadius = Math.min(width, height) * 0.16;
    const sunX = (width * 0.5) - (state.skyOffset * 0.35);
    const sunY = height * 0.38;

    const sunGrad = ctx.createLinearGradient(0, sunY - sunRadius, 0, sunY + sunRadius);
    sunGrad.addColorStop(0, COLORS.SUN_TOP);
    sunGrad.addColorStop(1, COLORS.SUN_BOTTOM);

    ctx.save();
    ctx.beginPath();
    ctx.arc(sunX, sunY, sunRadius, 0, Math.PI * 2);
    ctx.fillStyle = sunGrad;
    ctx.shadowColor = '#ff007f';
    ctx.shadowBlur = 35;
    ctx.fill();
    ctx.restore();

    // Sun horizon cutouts
    ctx.fillStyle = COLORS.SKY_HORIZON;
    for (let i = 0; i < 6; i++) {
        const stripeY = sunY + (i * sunRadius * 0.16);
        const stripeH = 1.5 + i * 1.1;
        ctx.fillRect(sunX - sunRadius, stripeY, sunRadius * 2, stripeH);
    }

    // 4. Parallax Cyber Mountains
    ctx.fillStyle = '#0d0822';
    ctx.strokeStyle = 'rgba(0, 243, 255, 0.35)';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    const horizonY = height * 0.52;
    ctx.moveTo(0, horizonY);
    const step = 70;
    for (let x = -step; x <= width + step; x += step) {
        const worldX = x + state.skyOffset;
        const peak = Math.abs(Math.sin(worldX * 0.004) * 55 + Math.cos(worldX * 0.011) * 30);
        ctx.lineTo(x, horizonY - peak);
    }
    ctx.lineTo(width, horizonY);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
}

function drawRoadsideSprite(sprite, scale, destX, destY, roadW) {
    if (sprite.type === 'pylon') {
        const h = 580 * scale * (width / 1000);
        const w = 18 * scale * (width / 1000);
        if (h < 2) return;

        // Metallic pole
        ctx.fillStyle = '#2b304d';
        ctx.fillRect(destX - w / 2, destY - h, w, h);

        // Glowing Neon Light Arm
        const armW = w * 3.5 * (sprite.offset < 0 ? 1 : -1);
        ctx.fillStyle = '#00f3ff';
        ctx.fillRect(destX, destY - h, armW, Math.max(2, w * 0.6));
    } else if (sprite.type === 'palm') {
        const h = 720 * scale * (width / 1000);
        const w = 24 * scale * (width / 1000);
        if (h < 3) return;

        // Trunk
        ctx.fillStyle = '#1b112c';
        ctx.fillRect(destX - w / 2, destY - h, w, h);

        // Neon Fronds
        ctx.strokeStyle = '#ff007f';
        ctx.lineWidth = Math.max(1.5, 4 * scale * (width / 1000));
        const frondLen = w * 5.5;
        for (let a = -2; a <= 2; a++) {
            ctx.beginPath();
            ctx.moveTo(destX, destY - h);
            ctx.quadraticCurveTo(
                destX + a * frondLen * 0.6,
                destY - h - frondLen * 0.4,
                destX + a * frondLen,
                destY - h + frondLen * 0.3
            );
            ctx.stroke();
        }
    } else if (sprite.type === 'arch') {
        // Checkpoint Overhead Neon Arch
        const archH = 680 * scale * (width / 1000);
        const pillarW = 45 * scale * (width / 1000);
        if (archH < 4) return;

        const leftX = destX - roadW * 1.05;
        const rightX = destX + roadW * 1.05;

        ctx.fillStyle = '#11162b';
        ctx.fillRect(leftX - pillarW / 2, destY - archH, pillarW, archH);
        ctx.fillRect(rightX - pillarW / 2, destY - archH, pillarW, archH);

        // Glowing Banner
        const bannerH = archH * 0.22;
        ctx.fillStyle = '#ff007f';
        ctx.fillRect(leftX - pillarW / 2, destY - archH, (rightX - leftX) + pillarW, bannerH);

        if (bannerH > 10) {
            ctx.fillStyle = '#ffe600';
            ctx.font = `900 ${Math.floor(bannerH * 0.65)}px Orbitron, sans-serif`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('CHECKPOINT', destX, destY - archH + bannerH / 2);
        }
    }
}

function drawTrafficCar(car, scale, destX, destY) {
    const carW = 460 * scale * (width / 1000);
    const carH = 230 * scale * (width / 1000);
    if (carW < 3) return;

    const x = destX - carW / 2;
    const y = destY - carH;

    // Ground shadow
    ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';
    ctx.fillRect(x - carW * 0.05, destY - carH * 0.12, carW * 1.1, carH * 0.16);

    // Tires
    ctx.fillStyle = '#07080d';
    const tireW = carW * 0.18;
    const tireH = carH * 0.25;
    ctx.fillRect(x + carW * 0.04, destY - tireH, tireW, tireH);
    ctx.fillRect(x + carW * 0.78, destY - tireH, tireW, tireH);

    // Main Chassis
    ctx.fillStyle = car.style.body;
    ctx.beginPath();
    ctx.roundRect(x, y + carH * 0.35, carW, carH * 0.52, carW * 0.08);
    ctx.fill();

    // Cabin / Rear Windshield
    ctx.fillStyle = '#0d1124';
    ctx.beginPath();
    ctx.moveTo(x + carW * 0.16, y + carH * 0.36);
    ctx.lineTo(x + carW * 0.26, y + carH * 0.05);
    ctx.lineTo(x + carW * 0.74, y + carH * 0.05);
    ctx.lineTo(x + carW * 0.84, y + carH * 0.36);
    ctx.closePath();
    ctx.fill();

    // Glowing Tail Lights
    ctx.fillStyle = '#ff1e42';
    const lightW = carW * 0.22;
    const lightH = carH * 0.12;
    ctx.fillRect(x + carW * 0.08, y + carH * 0.48, lightW, lightH);
    ctx.fillRect(x + carW * 0.70, y + carH * 0.48, lightW, lightH);
}

function drawPlayerCar() {
    const baseW = Math.min(width * 0.22, 195);
    const baseH = baseW * 0.48;
    const centerX = width * 0.5 + (state.steerAngle * 24);
    const bottomY = height - Math.max(22, height * 0.045) + Math.sin(state.position * 0.04) * (state.speed / CONFIG.MAX_SPEED) * 2.5;

    ctx.save();
    ctx.translate(centerX, bottomY);
    // Subtle chassis body roll during steering
    ctx.rotate(state.steerAngle * 0.045);

    const w = baseW;
    const h = baseH;
    const x = -w / 2;
    const y = -h;

    // 1. Underglow Neon Shadow
    ctx.fillStyle = state.isNitro ? 'rgba(0, 243, 255, 0.45)' : 'rgba(255, 0, 127, 0.3)';
    ctx.beginPath();
    ctx.ellipse(0, -h * 0.05, w * 0.56, h * 0.16, 0, 0, Math.PI * 2);
    ctx.fill();

    // 2. Wide Rear Tires
    ctx.fillStyle = '#090a10';
    const tireW = w * 0.21;
    const tireH = h * 0.34;
    ctx.beginPath();
    ctx.roundRect(x - w * 0.02, -tireH, tireW, tireH, 5);
    ctx.roundRect(x + w - tireW + w * 0.02, -tireH, tireW, tireH, 5);
    ctx.fill();

    // 3. Lower Rear Diffuser & Bumper
    ctx.fillStyle = '#121524';
    ctx.beginPath();
    ctx.roundRect(x + w * 0.04, y + h * 0.55, w * 0.92, h * 0.35, 8);
    ctx.fill();

    // 4. Sculpted Supercar Body
    const bodyGrad = ctx.createLinearGradient(0, y + h * 0.25, 0, y + h * 0.75);
    bodyGrad.addColorStop(0, state.playerColor);
    bodyGrad.addColorStop(1, '#1a0a1e');
    ctx.fillStyle = bodyGrad;
    ctx.beginPath();
    ctx.moveTo(x + w * 0.03, y + h * 0.65);
    ctx.lineTo(x + w * 0.10, y + h * 0.35);
    ctx.lineTo(x + w * 0.90, y + h * 0.35);
    ctx.lineTo(x + w * 0.97, y + h * 0.65);
    ctx.closePath();
    ctx.fill();

    // 5. Aerodynamic Cabin Canopy
    ctx.fillStyle = '#0b1021';
    ctx.beginPath();
    ctx.moveTo(x + w * 0.18, y + h * 0.36);
    ctx.lineTo(x + w * 0.28, y + h * 0.06);
    ctx.lineTo(x + w * 0.72, y + h * 0.06);
    ctx.lineTo(x + w * 0.82, y + h * 0.36);
    ctx.closePath();
    ctx.fill();

    // Neon Roof Trim
    ctx.strokeStyle = state.playerAccent;
    ctx.lineWidth = 2.5;
    ctx.stroke();

    // 6. Carbon Fiber Rear Spoiler Wing
    ctx.fillStyle = '#0f1326';
    ctx.fillRect(x + w * 0.16, y + h * 0.22, w * 0.04, h * 0.16);
    ctx.fillRect(x + w * 0.80, y + h * 0.22, w * 0.04, h * 0.16);
    ctx.fillStyle = state.playerColor;
    ctx.beginPath();
    ctx.roundRect(x + w * 0.02, y + h * 0.17, w * 0.96, h * 0.08, 4);
    ctx.fill();

    // 7. Full-Width LED Cyber Tail Light Bar
    ctx.save();
    ctx.shadowColor = '#ff0044';
    ctx.shadowBlur = state.keys.down ? 22 : 12;
    ctx.fillStyle = state.keys.down ? '#ffffff' : '#ff1e56';
    ctx.fillRect(x + w * 0.09, y + h * 0.44, w * 0.82, h * 0.09);
    ctx.restore();

    // 8. Dual Exhaust Pipes & Nitro Afterburner Flames
    const leftPipeX = x + w * 0.26;
    const rightPipeX = x + w * 0.74;
    const pipeY = y + h * 0.78;

    ctx.fillStyle = '#2d334d';
    ctx.beginPath();
    ctx.arc(leftPipeX, pipeY, w * 0.035, 0, Math.PI * 2);
    ctx.arc(rightPipeX, pipeY, w * 0.035, 0, Math.PI * 2);
    ctx.fill();

    if (state.isNitro || state.speed > CONFIG.MAX_SPEED * 0.85) {
        const flameLen = state.isNitro ? (28 + Math.random() * 24) : (8 + Math.random() * 8);
        const flameColor = state.isNitro ? '#00f3ff' : '#ff8800';
        ctx.save();
        ctx.fillStyle = flameColor;
        ctx.shadowColor = flameColor;
        ctx.shadowBlur = 15;
        [leftPipeX, rightPipeX].forEach(px => {
            ctx.beginPath();
            ctx.moveTo(px - w * 0.025, pipeY);
            ctx.lineTo(px + w * 0.025, pipeY);
            ctx.lineTo(px, pipeY + flameLen);
            ctx.closePath();
            ctx.fill();
        });
        ctx.restore();
    }

    ctx.restore();
}

function render() {
    ctx.clearRect(0, 0, width, height);

    ctx.save();
    // Apply camera shake on impacts or nitro boost
    if (state.screenShake > 0) {
        const sx = (Math.random() - 0.5) * state.screenShake;
        const sy = (Math.random() - 0.5) * state.screenShake;
        ctx.translate(sx, sy);
    }

    drawBackground();

    const baseSegment = findSegment(state.position);
    if (!baseSegment) {
        ctx.restore();
        return;
    }

    const basePercent = (state.position % CONFIG.SEGMENT_LENGTH) / CONFIG.SEGMENT_LENGTH;
    const playerSegment = findSegment(state.position + state.playerZ);
    const playerPercent = ((state.position + state.playerZ) % CONFIG.SEGMENT_LENGTH) / CONFIG.SEGMENT_LENGTH;
    const playerY = playerSegment.p1.world.y + (playerSegment.p2.world.y - playerSegment.p1.world.y) * playerPercent;

    let maxy = height;
    let x = 0;
    let dx = -(baseSegment.curve * basePercent);

    // Store visible segments to draw sprites/cars back-to-front
    const visibleSegments = [];

    // 1. Forward Pass: Project and draw road polygons
    for (let n = 0; n < CONFIG.DRAW_DISTANCE; n++) {
        const segIndex = (baseSegment.index + n) % state.segments.length;
        const segment = state.segments[segIndex];
        const looped = segment.index < baseSegment.index;
        const camZ = state.position - (looped ? state.trackLength : 0);

        project(segment.p1, (state.playerX * CONFIG.ROAD_WIDTH) - x, playerY + CONFIG.CAMERA_HEIGHT, camZ, CONFIG.CAMERA_DEPTH, width, height, CONFIG.ROAD_WIDTH);
        project(segment.p2, (state.playerX * CONFIG.ROAD_WIDTH) - x - dx, playerY + CONFIG.CAMERA_HEIGHT, camZ, CONFIG.CAMERA_DEPTH, width, height, CONFIG.ROAD_WIDTH);

        x += dx;
        dx += segment.curve;

        segment.clip = maxy;

        if ((segment.p1.camera.z <= CONFIG.CAMERA_DEPTH) ||
            (segment.p2.screen.y >= segment.p1.screen.y) ||
            (segment.p2.screen.y >= maxy)) {
            continue;
        }

        const x1 = segment.p1.screen.x, y1 = segment.p1.screen.y, w1 = segment.p1.screen.w;
        const x2 = segment.p2.screen.x, y2 = segment.p2.screen.y, w2 = segment.p2.screen.w;

        const r1 = w1 / 7, r2 = w2 / 7;
        const l1 = w1 / 45, l2 = w2 / 45;

        // Grass terrain
        ctx.fillStyle = segment.color.grass;
        ctx.fillRect(0, y2, width, y1 - y2);

        // Rumble strips
        drawPolygon(x1 - w1 - r1, y1, x1 - w1, y1, x2 - w2, y2, x2 - w2 - r2, y2, segment.color.rumble);
        drawPolygon(x1 + w1 + r1, y1, x1 + w1, y1, x2 + w2, y2, x2 + w2 + r2, y2, segment.color.rumble);

        // Asphalt surface
        drawPolygon(x1 - w1, y1, x1 + w1, y1, x2 + w2, y2, x2 - w2, y2, segment.color.road);

        // Neon Lane Dividers
        if (segment.color.lane) {
            const laneW1 = w1 * 2 / CONFIG.LANES;
            const laneW2 = w2 * 2 / CONFIG.LANES;
            let laneX1 = x1 - w1 + laneW1;
            let laneX2 = x2 - w2 + laneW2;
            for (let lane = 1; lane < CONFIG.LANES; lane++, laneX1 += laneW1, laneX2 += laneW2) {
                drawPolygon(laneX1 - l1 / 2, y1, laneX1 + l1 / 2, y1, laneX2 + l2 / 2, y2, laneX2 - l2 / 2, y2, segment.color.lane);
            }
        }

        maxy = y2;
        visibleSegments.push(segment);
    }

    // 2. Reverse Pass: Draw roadside scenery & rival traffic back-to-front
    for (let i = visibleSegments.length - 1; i >= 0; i--) {
        const seg = visibleSegments[i];

        // Clip below horizon/hills
        ctx.save();
        ctx.beginPath();
        ctx.rect(0, 0, width, seg.clip);
        ctx.clip();

        // Draw roadside props
        for (const sprite of seg.sprites) {
            const spriteX = seg.p1.screen.x + (seg.p1.screen.scale * sprite.offset * CONFIG.ROAD_WIDTH * width / 2);
            drawRoadsideSprite(sprite, seg.p1.screen.scale, spriteX, seg.p1.screen.y, seg.p1.screen.w);
        }

        // Draw traffic cars on this segment
        for (const car of seg.cars) {
            const carPercent = (car.z % CONFIG.SEGMENT_LENGTH) / CONFIG.SEGMENT_LENGTH;
            const scale = seg.p1.screen.scale + (seg.p2.screen.scale - seg.p1.screen.scale) * carPercent;
            const screenX = (seg.p1.screen.x + (seg.p2.screen.x - seg.p1.screen.x) * carPercent) + (scale * car.offset * CONFIG.ROAD_WIDTH * width / 2);
            const screenY = seg.p1.screen.y + (seg.p2.screen.y - seg.p1.screen.y) * carPercent;
            drawTrafficCar(car, scale, screenX, screenY);
        }

        ctx.restore();
    }

    // 3. Draw Player Supercar
    drawPlayerCar();

    // 4. Draw Particles (Sparks, Speed Lines, Debris)
    for (const p of state.particles) {
        ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fill();
    }
    ctx.globalAlpha = 1.0;

    // 5. Speed Warp Lines at High Velocity
    if (state.speed > CONFIG.MAX_SPEED * 0.78) {
        const intensity = (state.speed - CONFIG.MAX_SPEED * 0.78) / (CONFIG.NITRO_MAX_SPEED - CONFIG.MAX_SPEED * 0.78);
        ctx.strokeStyle = state.isNitro ? `rgba(0, 243, 255, ${intensity * 0.45})` : `rgba(255, 255, 255, ${intensity * 0.25})`;
        ctx.lineWidth = 2;
        for (let i = 0; i < 14; i++) {
            const angle = (i / 14) * Math.PI * 2 + (state.position * 0.0005);
            const r1 = Math.min(width, height) * (0.38 + Math.random() * 0.1);
            const r2 = Math.max(width, height) * 0.75;
            ctx.beginPath();
            ctx.moveTo(width / 2 + Math.cos(angle) * r1, height / 2 + Math.sin(angle) * r1);
            ctx.lineTo(width / 2 + Math.cos(angle) * r2, height / 2 + Math.sin(angle) * r2);
            ctx.stroke();
        }
    }

    ctx.restore();
}

// ============================================================================
// 7. PHYSICS, COLLISIONS & GAME LOOP UPDATE
// ============================================================================
let bannerTimeout = null;
function showBanner(title, subtitle, colorClass = 'text-yellow-300') {
    const banner = document.getElementById('floating-banner');
    const titleEl = document.getElementById('banner-title');
    const subEl = document.getElementById('banner-sub');

    titleEl.textContent = title;
    titleEl.className = `font-arcade text-2xl sm:text-4xl font-black tracking-wider ${colorClass} neon-text-cyan`;
    subEl.textContent = subtitle;

    banner.style.opacity = '1';
    clearTimeout(bannerTimeout);
    bannerTimeout = setTimeout(() => {
        banner.style.opacity = '0';
    }, 1500);
}

function update(dt) {
    // Decay screen shake
    if (state.screenShake > 0) {
        state.screenShake = Math.max(0, state.screenShake - dt * 35);
    }

    // Update particles
    for (let i = state.particles.length - 1; i >= 0; i--) {
        const p = state.particles[i];
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.life -= dt;
        if (p.life <= 0) state.particles.splice(i, 1);
    }

    // Demo attract mode camera movement when on Start Menu
    if (state.status === 'MENU') {
        state.position = (state.position + 4500 * dt) % state.trackLength;
        const seg = findSegment(state.position);
        if (seg) state.skyOffset += seg.curve * 0.4;
        return;
    }

    if (state.status !== 'PLAYING') {
        sound.updateEngine(0, false, false);
        return;
    }

    // 1. Timer Countdown
    state.timeLeft -= dt;
    if (state.timeLeft <= 0) {
        state.timeLeft = 0;
        triggerGameOver('Time Expired');
        return;
    }

    // 2. Nitro Boost Handling
    if (state.keys.nitro && state.nitro > 2 && state.speed > 2000) {
        state.isNitro = true;
        state.nitro = Math.max(0, state.nitro - 28 * dt);
        state.screenShake = Math.max(state.screenShake, 2.5);
    } else {
        state.isNitro = false;
        // Slowly regenerate nitro while driving fast
        if (state.speed > 4000) {
            state.nitro = Math.min(100, state.nitro + 6 * dt);
        }
    }

    // 3. Longitudinal Acceleration & Braking
    const currentMaxSpeed = state.isNitro ? CONFIG.NITRO_MAX_SPEED : CONFIG.MAX_SPEED;
    if (state.isNitro) {
        state.speed += CONFIG.ACCEL * 1.75 * dt;
    } else if (state.keys.up) {
        state.speed += CONFIG.ACCEL * dt;
    } else if (state.keys.down) {
        state.speed += CONFIG.BRAKING * dt;
    } else {
        state.speed += CONFIG.DECEL * dt;
    }

    // Off-road gravel drag penalty
    if (Math.abs(state.playerX) > 1.02) {
        if (state.speed > CONFIG.OFF_ROAD_LIMIT) {
            state.speed += CONFIG.OFF_ROAD_DECEL * dt;
        }
        // Kick up gravel sparks
        if (state.speed > 2000 && Math.random() < 0.6) {
            spawnParticle(
                width * 0.5 + (Math.random() - 0.5) * 140,
                height - 30,
                (Math.random() - 0.5) * 120,
                -60 - Math.random() * 80,
                '#ff007f',
                3.5,
                0.35
            );
        }
    }

    state.speed = Math.max(0, Math.min(state.speed, currentMaxSpeed));

    // 4. Advance Position & Track Curves
    const prevPosition = state.position;
    state.position += state.speed * dt;
    if (state.position >= state.trackLength) {
        state.position -= state.trackLength;
    }

    const playerSegment = findSegment(state.position + state.playerZ);
    const speedRatio = state.speed / CONFIG.MAX_SPEED;

    // 5. Steering & Centrifugal Curve Physics
    const steerInput = (state.keys.right ? 1 : 0) - (state.keys.left ? 1 : 0);
    state.steerAngle += (steerInput - state.steerAngle) * Math.min(1, dt * 12);

    const dx = dt * 1.85 * Math.min(1.1, speedRatio);
    state.playerX += state.steerAngle * dx;
    // Centrifugal force pulls car toward outside of curves
    state.playerX -= (dx * speedRatio * playerSegment.curve * CONFIG.CENTRIFUGAL);
    state.playerX = Math.max(-2.1, Math.min(2.1, state.playerX));

    // Rotate sky parallax based on curve
    state.skyOffset += playerSegment.curve * speedRatio * 1.4;

    // 6. Checkpoint Detection
    if (playerSegment.isCheckpoint && !playerSegment.checkpointPassed) {
        playerSegment.checkpointPassed = true;
        state.stage++;
        const bonusTime = Math.max(12, 22 - state.stage);
        state.timeLeft = Math.min(60, state.timeLeft + bonusTime);
        state.score += 2500 * state.stage;
        sound.playCheckpoint();
        showBanner(`STAGE ${state.stage} REACHED!`, `+${bonusTime}s TIME EXTENSION`, 'text-emerald-300');

        // Reset flag for future laps
        setTimeout(() => { playerSegment.checkpointPassed = false; }, 5000);
    }

    // 7. Traffic AI & Collision Detection
    const playerWorldZ = (state.position + state.playerZ) % state.trackLength;
    const playerHalfW = 0.21;

    for (const car of state.cars) {
        // Move traffic forward
        const oldSeg = findSegment(car.z);
        car.z = (car.z + car.speed * dt) % state.trackLength;
        const newSeg = findSegment(car.z);

        // Occasional smart lane switching
        car.laneChangeTimer -= dt;
        if (car.laneChangeTimer <= 0) {
            car.laneChangeTimer = 3 + Math.random() * 4;
            const lanes = [-0.62, 0, 0.62];
            car.targetOffset = lanes[Math.floor(Math.random() * lanes.length)];
        }
        car.offset += (car.targetOffset - car.offset) * dt * 1.8;

        if (oldSeg !== newSeg) {
            if (oldSeg) {
                const idx = oldSeg.cars.indexOf(car);
                if (idx > -1) oldSeg.cars.splice(idx, 1);
            }
            if (newSeg) newSeg.cars.push(car);
        }

        // Check Z-overlap with player
        let dz = car.z - playerWorldZ;
        if (dz < -state.trackLength / 2) dz += state.trackLength;
        if (dz > state.trackLength / 2) dz -= state.trackLength;

        const lateralDist = Math.abs(state.playerX - car.offset);
        const combinedHalfW = playerHalfW + car.style.width * 0.85;

        // Direct Collision!
        if (Math.abs(dz) < 175 && lateralDist < combinedHalfW) {
            sound.playCrash();
            state.screenShake = 18;
            state.speed *= 0.35;
            state.timeLeft = Math.max(0, state.timeLeft - 3.0);
            // Push car out of collision box
            car.z = (car.z + 320) % state.trackLength;
            showBanner('IMPACT!', '-3.0 SECONDS', 'text-red-400');

            // Explosion of sparks
            for (let s = 0; s < 24; s++) {
                spawnParticle(
                    width * 0.5 + (Math.random() - 0.5) * 120,
                    height - 80,
                    (Math.random() - 0.5) * 450,
                    -150 - Math.random() * 280,
                    s % 2 === 0 ? '#ffe600' : '#ff0055',
                    4 + Math.random() * 4,
                    0.55
                );
            }
        }
        // Near-Miss Bonus!
        else if (dz < -175 && dz > -360 && !car.nearMissed && lateralDist < combinedHalfW + 0.26 && state.speed > 7500) {
            car.nearMissed = true;
            state.nearMisses++;
            state.score += 500;
            state.nitro = Math.min(100, state.nitro + 18);
            sound.playNearMiss();
            showBanner('NEAR MISS!', '+500 PTS & +18% NITRO', 'text-cyan-300');
            setTimeout(() => { car.nearMissed = false; }, 2500);
        }
    }

    // 8. Score & Distance Accumulation
    const distDelta = (state.speed * dt) / 10000;
    state.distance += distDelta;
    state.score += Math.floor((state.speed * dt) * 0.045 * (state.isNitro ? 1.5 : 1));

    // Update Engine Synthesizer
    sound.updateEngine(state.speed / CONFIG.MAX_SPEED, state.isNitro, true);
    updateHUD();
}

// ============================================================================
// 8. HUD & UI STATE CONTROLLERS
// ============================================================================
const hudScore = document.getElementById('hud-score');
const hudBest = document.getElementById('hud-best');
const hudTime = document.getElementById('hud-time');
const hudStage = document.getElementById('hud-stage');
const hudSpeed = document.getElementById('hud-speed');
const hudNitroBar = document.getElementById('hud-nitro-bar');
const hudNitroText = document.getElementById('hud-nitro-text');

function updateHUD() {
    hudScore.textContent = String(state.score).padStart(6, '0');
    if (state.score > highScore) {
        highScore = state.score;
        try { localStorage.setItem('neon_velocity_best', String(highScore)); } catch (e) {}
    }
    hudBest.textContent = String(highScore).padStart(6, '0');

    hudTime.textContent = state.timeLeft.toFixed(1);
    if (state.timeLeft <= 10.0) {
        hudTime.classList.add('timer-warning');
    } else {
        hudTime.classList.remove('timer-warning');
    }

    hudStage.textContent = `Stage ${state.stage}`;
    const kmh = Math.round((state.speed / CONFIG.MAX_SPEED) * 265);
    hudSpeed.textContent = kmh;

    const nitroPct = Math.round(state.nitro);
    hudNitroBar.style.width = `${nitroPct}%`;
    hudNitroText.textContent = `${nitroPct}%`;
}

function startGame() {
    sound.init();
    buildTrack();
    spawnTraffic();

    state.status = 'PLAYING';
    state.position = 0;
    state.playerX = 0;
    state.speed = 0;
    state.steerAngle = 0;
    state.nitro = 100;
    state.isNitro = false;
    state.score = 0;
    state.distance = 0;
    state.timeLeft = CONFIG.INITIAL_TIME;
    state.stage = 1;
    state.nearMisses = 0;
    state.particles = [];

    document.getElementById('menu-start').classList.add('hidden');
    document.getElementById('menu-pause').classList.add('hidden');
    document.getElementById('menu-gameover').classList.add('hidden');
    document.getElementById('hud-container').classList.remove('hidden');

    // Show touch controls on mobile/tablet viewports
    if ('ontouchstart' in window || navigator.maxTouchPoints > 0 || window.innerWidth < 768) {
        document.getElementById('touch-controls').classList.remove('hidden');
    }

    updateHUD();
}

function togglePause() {
    if (state.status === 'PLAYING') {
        state.status = 'PAUSED';
        document.getElementById('menu-pause').classList.remove('hidden');
    } else if (state.status === 'PAUSED') {
        state.status = 'PLAYING';
        document.getElementById('menu-pause').classList.add('hidden');
    }
}

function triggerGameOver(reason) {
    state.status = 'GAMEOVER';
    sound.updateEngine(0, false, false);

    document.getElementById('gameover-reason').textContent = reason;
    document.getElementById('final-score').textContent = state.score.toLocaleString();
    document.getElementById('final-best').textContent = highScore.toLocaleString();
    document.getElementById('final-distance').textContent = `${state.distance.toFixed(1)} km`;
    document.getElementById('final-nearmiss').textContent = state.nearMisses;

    document.getElementById('menu-gameover').classList.remove('hidden');
    document.getElementById('touch-controls').classList.add('hidden');
}

// ============================================================================
// 9. INPUT LISTENERS & RESPONSIVE RESIZING
// ============================================================================
function handleResize() {
    width = canvas.width = window.innerWidth;
    height = canvas.height = window.innerHeight;
}
window.addEventListener('resize', handleResize);

// Keyboard Controls
window.addEventListener('keydown', (e) => {
    switch (e.code) {
        case 'ArrowLeft':
        case 'KeyA':
            state.keys.left = true;
            break;
        case 'ArrowRight':
        case 'KeyD':
            state.keys.right = true;
            break;
        case 'ArrowUp':
        case 'KeyW':
            state.keys.up = true;
            break;
        case 'ArrowDown':
        case 'KeyS':
            state.keys.down = true;
            break;
        case 'ShiftLeft':
        case 'ShiftRight':
        case 'Space':
            state.keys.nitro = true;
            break;
        case 'Escape':
        case 'KeyP':
            if (state.status === 'PLAYING' || state.status === 'PAUSED') togglePause();
            break;
    }
});

window.addEventListener('keyup', (e) => {
    switch (e.code) {
        case 'ArrowLeft':
        case 'KeyA':
            state.keys.left = false;
            break;
        case 'ArrowRight':
        case 'KeyD':
            state.keys.right = false;
            break;
        case 'ArrowUp':
        case 'KeyW':
            state.keys.up = false;
            break;
        case 'ArrowDown':
        case 'KeyS':
            state.keys.down = false;
            break;
        case 'ShiftLeft':
        case 'ShiftRight':
        case 'Space':
            state.keys.nitro = false;
            break;
    }
});

// Touch Button Binding Helper
function bindTouchControl(elementId, keyName) {
    const el = document.getElementById(elementId);
    if (!el) return;

    const startHandler = (e) => {
        e.preventDefault();
        state.keys[keyName] = true;
        el.classList.add('active');
    };
    const endHandler = (e) => {
        e.preventDefault();
        state.keys[keyName] = false;
        el.classList.remove('active');
    };

    el.addEventListener('touchstart', startHandler, { passive: false });
    el.addEventListener('touchend', endHandler, { passive: false });
    el.addEventListener('touchcancel', endHandler, { passive: false });
    el.addEventListener('mousedown', startHandler);
    el.addEventListener('mouseup', endHandler);
    el.addEventListener('mouseleave', endHandler);
}

bindTouchControl('touch-left', 'left');
bindTouchControl('touch-right', 'right');
bindTouchControl('touch-gas', 'up');
bindTouchControl('touch-brake', 'down');
bindTouchControl('touch-nitro', 'nitro');

// UI Buttons
document.getElementById('btn-start').addEventListener('click', startGame);
document.getElementById('btn-play-again').addEventListener('click', startGame);
document.getElementById('btn-restart-pause').addEventListener('click', startGame);
document.getElementById('btn-resume').addEventListener('click', togglePause);
document.getElementById('btn-pause').addEventListener('click', togglePause);

document.getElementById('btn-sound').addEventListener('click', () => {
    sound.init();
    const isOn = sound.toggle();
    document.getElementById('icon-sound-on').classList.toggle('hidden', !isOn);
    document.getElementById('icon-sound-off').classList.toggle('hidden', isOn);
});

// Car Color Swatch Selector
document.querySelectorAll('.color-swatch').forEach(btn => {
    btn.addEventListener('click', () => {
        document.querySelectorAll('.color-swatch').forEach(b => {
            b.classList.remove('ring-2', 'ring-pink-500', 'scale-110', 'border-white');
            b.classList.add('border-white/40');
        });
        btn.classList.add('ring-2', 'ring-pink-500', 'scale-110', 'border-white');
        btn.classList.remove('border-white/40');
        state.playerColor = btn.dataset.color;
        state.playerAccent = btn.dataset.accent;
    });
});

// ============================================================================
// 10. MAIN ANIMATION LOOP
// ============================================================================
let lastTimestamp = 0;

function gameLoop(timestamp) {
    if (!lastTimestamp) lastTimestamp = timestamp;
    const dt = Math.min(0.05, (timestamp - lastTimestamp) / 1000);
    lastTimestamp = timestamp;

    update(dt);
    render();

    requestAnimationFrame(gameLoop);
}

window.onload = function () {
    handleResize();
    buildTrack();
    hudBest.textContent = String(highScore).padStart(6, '0');
    requestAnimationFrame(gameLoop);
};
</script>
