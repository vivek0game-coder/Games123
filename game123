// ============================================================================
// 4. TRACK GENERATION & GEOMETRY HELPERS
// ============================================================================
function easeIn(a, b, percent) { return a + (b - a) * Math.pow(percent, 2); }
function easeOut(a, b, percent) { return a + (b - a) * (1 - Math.pow(1 - percent, 2)); }
function easeInOut(a, b, percent) { return a + (b - a) * ((-Math.cos(percent * Math.PI) / 2) + 0.5); }

function lastY() {
    return (state.segments.length === 0) ? 0 : state.segments[state.segments.length - 1].p2.world.y;
}

function addSegment(curve, y) {
    const n = state.segments.length;
    const isCheckpoint = (n > 20 && n % CONFIG.CHECKPOINT_INTERVAL === 0);
    
    let colorScheme = Math.floor(n / CONFIG.RUMBLE_LENGTH) % 2 ? COLORS.DARK : COLORS.LIGHT;
    if (isCheckpoint) colorScheme = COLORS.CHECKPOINT;

    // Generate roadside neon palm trees / light pylons
    const sprites = [];
    if (n % 8 === 0) {
        sprites.push({ type: 'pylon', offset: -1.35 });
        sprites.push({ type: 'pylon', offset: 1.35 });
    } else if (n % 14 === 0) {
        sprites.push({ type: 'palm', offset: -1.65 - Math.random() * 0.8 });
        sprites.push({ type: 'palm', offset: 1.65 + Math.random() * 0.8 });
    }
    if (isCheckpoint) {
        sprites.push({ type: 'arch', offset: 0 });
    }

    state.segments.push({
        index: n,
        p1: { world: { y: lastY(), z: n * CONFIG.SEGMENT_LENGTH }, camera: {}, screen: {} },
        p2: { world: { y: y, z: (n + 1) * CONFIG.SEGMENT_LENGTH }, camera: {}, screen: {} },
        curve: curve,
        sprites: sprites,
        cars: [],
        color: colorScheme,
        isCheckpoint: isCheckpoint,
        checkpointPassed: false
    });
}

function addRoad(enter, hold, leave, curve, y) {
    const startY = lastY();
    const endY = startY + (y * CONFIG.SEGMENT_LENGTH);
    const total = enter + hold + leave;

    for (let n = 0; n < enter; n++) {
        addSegment(easeIn(0, curve, n / enter), easeInOut(startY, endY, n / total));
    }
    for (let n = 0; n < hold; n++) {
        addSegment(curve, easeInOut(startY, endY, (enter + n) / total));
    }
    for (let n = 0; n < leave; n++) {
        addSegment(easeInOut(curve, 0, n / leave), easeInOut(startY, endY, (enter + hold + n) / total));
    }
}

function buildTrack() {
    state.segments = [];

    // Construct a varied, exhilarating continuous circuit
    addRoad(30, 40, 30, 0, 0);         // Starting straight
    addRoad(40, 60, 40, 2.2, 25);      // Sweeping right uphill
    addRoad(30, 50, 30, -1.8, -20);    // Fast left downhill
    addRoad(40, 70, 40, 0, 35);        // Steep cyber-hill climb
    addRoad(35, 60, 35, -3.2, -35);    // Sharp hairpin left descent
    addRoad(25, 45, 25, 2.8, 15);      // S-bend right
    addRoad(25, 45, 25, -2.8, -15);    // S-bend left
    addRoad(50, 80, 50, 1.5, 40);      // Long scenic crest
    addRoad(40, 60, 40, -2.5, -40);    // High-speed plunge
    addRoad(30, 60, 30, 0, 0);         // Final sprint straight

    state.trackLength = state.segments.length * CONFIG.SEGMENT_LENGTH;
}

function findSegment(z) {
    const len = state.segments.length;
    if (len === 0) return null;
    const idx = Math.floor(z / CONFIG.SEGMENT_LENGTH) % len;
    return state.segments[(idx + len) % len];
}

